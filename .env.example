# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=whatsapp-ai-agent-secret-key-change-this-in-production

# Google Gemini AI (Required for real AI auto-replies)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta WhatsApp Cloud API (Optional: for connecting a live Meta WhatsApp Business number)
WHATSAPP_API_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_account_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret
